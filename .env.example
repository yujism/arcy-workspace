# Optional AI. Secrets must be configured on the server, never NEXT_PUBLIC_*.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional Google data access for the single owner. Sign-in remains platform-managed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_OWNER_USER_ID=

# Vercel persistent login: GOOGLE_CLIENT_SECRET above is required.
# Defaults reuse pages/google-config.json and https://arcy-workspace.vercel.app.
# Optional overrides (server-only):
# ARCY_APP_ORIGIN=https://arcy-workspace.vercel.app
# ARCY_SESSION_SECRET=<64 hexadecimal characters>
